# Copy to .env and fill in generated PEM keys. Never commit .env.

DATABASE_USERNAME=books
DATABASE_PASSWORD=books

# Generate keys:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
# Paste full PEM contents below. For multi-line values in .env, wrap in double quotes
# and keep literal newlines, or replace newlines with \n.
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_PUBLIC_KEY=

AUTH_COOKIE_SECURE=false
OPEN_LIBRARY_USER_AGENT=BooksRandomized/1.0
PASSWORD_RESET_FROM=no-reply@books-randomized.invalid
